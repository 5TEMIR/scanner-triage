                "region": {"startLine": 42}
              }
            }
          ]
        },
        {
          "ruleId": "python.lang.security.audit.hardcoded-password",
          "level": "warning",
          "message": {"text": "Hardcoded password detected."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/config.py"},
                "region": {"startLine": 7}
              }
            }
          ]
        }
      ]
    }
  ]
}
